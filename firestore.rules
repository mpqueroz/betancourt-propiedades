rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /properties/{propertyId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /posts/{postId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Mensajes del formulario de contacto: cualquier visitante puede ENVIAR
    // uno (no está logeado), pero solo tú puedes leerlos o borrarlos.
    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Preguntas públicas: cualquiera puede publicar (queda oculta hasta que
    // tú la apruebes), cualquiera puede leer las ya aprobadas,
    // solo tú puedes aprobar/responder/editar/borrar.
    match /questions/{questionId} {
      allow read: if true;
      allow create: if request.resource.data.published == false;
      allow update, delete: if request.auth != null;
    }

    // Ajustes del sitio (ej: foto principal): lectura pública, solo tú editas.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

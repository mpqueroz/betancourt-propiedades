rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Fotos de propiedades: lectura pública (para que se vean en el sitio),
    // solo tú (logeado) puedes subir o borrar.
    match /properties/{propertyId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024 // máx 10MB por foto
                   && request.resource.contentType.matches('image/.*');
    }

    // Imágenes del blog: mismo criterio.
    match /blog/{postId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Fotos de ajustes del sitio (ej: foto principal / hero).
    match /site/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Todo lo demás queda bloqueado.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
